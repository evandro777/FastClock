<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.evandro777.FastClock</id>
  <name>FastClock</name>
  <summary>Alarm, timer, stopwatch and Pomodoro</summary>
  <metadata_license>FSFAP</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.evandro777">
    <name translatable="no">evandro777</name>
  </developer>
  <url type="homepage">https://github.com/evandro777/FastClock</url>
  <url type="bugtracker">https://github.com/evandro777/FastClock/issues</url>
  <description>
    <p>FastClock is a light and fast clock: alarms, a timer, a stopwatch and a simple Pomodoro. Alarms and timers ring a sound of your choice and raise a desktop notification with Snooze and Stop buttons, and keep working from the tray icon when the window is closed.</p>
  </description>
  <categories>
    <category>Utility</category>
    <category>Clock</category>
  </categories>
  <keywords>
    <keyword>alarm</keyword>
    <keyword>timer</keyword>
    <keyword>stopwatch</keyword>
    <keyword>pomodoro</keyword>
    <keyword>clock</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#f3b3ad</color>
    <color type="primary" scheme_preference="dark">#8a2a24</color>
  </branding>
